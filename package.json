{
  "name": "dsh-ai-suplex",
  "version": "0.4.0",
  "description": "The 7-7-7 execution loop for DeepSeek Harness — plan, run, capture, close, compound, with a human gate.",
  "type": "module",
  "license": "MIT",
  "author": "Kudakwashe Magwenzi",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./core": {
      "default": "./lib/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-suplex",
    "workflow",
    "memory",
    "execution"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmagwenzi/dsh-ai-suplex.git"
  },
  "homepage": "https://github.com/kmagwenzi/dsh-ai-suplex#readme",
  "bugs": {
    "url": "https://github.com/kmagwenzi/dsh-ai-suplex/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
